# DeepSeek AI API 配置
# 填入你的 API Key 后保存，运行 npm run dev:server 即可
AI_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

PORT=3099

# 前端生产构建（Cloudflare Pages 等平台）填境外 API 地址，不要末尾斜杠
# 开发留空即可，走 Vite 代理 /api → localhost:3099
# VITE_API_BASE_URL=https://api.dbti.fun
